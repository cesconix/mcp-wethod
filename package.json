{
  "name": "mcp-wethod",
  "version": "0.1.0",
  "description": "MCP server for Wethod project management — timesheet, planning, budgets, and team tools",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": "./dist/index.mjs",
  "bin": {
    "mcp-wethod": "./bin.mjs"
  },
  "files": [
    "dist",
    "bin.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "format": "biome check --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "^22.18.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "wethod",
    "timesheet",
    "project-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesconix/mcp-wethod"
  }
}
